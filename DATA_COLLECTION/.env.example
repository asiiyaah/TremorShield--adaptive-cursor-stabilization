# Token required to use the /admin/* endpoints. Use a long random value.
ADMIN_TOKEN=change-this-to-a-random-secret

# Email settings — Brevo HTTP API (HTTPS/443), not SMTP.
# Create a Brevo API key and verify the sender email address in Brevo.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=TREMORSHIELD
ADMIN_EMAIL=your_recipient@example.com
